# Household-level outputs: regenerate with run_harmonize.py, never publish
output/

# John's operations model: its tables hold real regional estimates (needs SISAAP/WFP agreement)
models/

# Shiny app data: aggregates by region; share deliberately, not via a public repo
app/data/
# Posit deployment records (account and app URL)
app/rsconnect/
# Login accounts and their secret; synthetic data are rebuilt with make_demo_data.R
app/accounts.sqlite
app/accounts_passwords.csv
app/.Renviron
app/demo_data/

# Analysis report, figures and tables (regional estimates); regenerate with analysis/render_report.R
analysis/output/
*.docx

# Raw survey microdata (not redistributable)
*.sav
*.dta
*.xlsx

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
notebooks/*.ipynb

# R session files
.Rhistory
.RData
.Rproj.user/
